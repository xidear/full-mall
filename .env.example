# ============================================================================
# 公开分叉模板 — 复制为 .env 后填写你自己的凭据与应用密钥
# Gitea 内部仓库的 .env 已含开发值；本文件只用于公开分叉与全新环境
# 占位值均为无害默认值，不包含任何真实密钥
# ============================================================================

# Compose
COMPOSE_PROJECT_NAME=fullmall

# Database
POSTGRES_DB=fullmall
POSTGRES_USER=fullmall
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=fullmall
RABBITMQ_DEFAULT_PASS=change-me-local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# OpenSearch
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# SeaweedFS
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Apps
API_PORT=8080
WS_PORT=8081
WORKER_ACTUATOR_PORT=8082
STOREFRONT_PORT=3000
ADMIN_PORT=5173
STORE_CONSOLE_PORT=5174
SUPPLIER_PORTAL_PORT=5175
SUPPORT_CONSOLE_PORT=5176

# Debug ports
API_DEBUG_PORT=5005
WORKER_DEBUG_PORT=5006
WS_DEBUG_PORT=5007

# Tools
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local
WIREMOCK_PORT=8089

# Observability
GRAFANA_PORT=3001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# AI (demo uses mock; production must configure a real provider)
OLLAMA_PORT=11434
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_RAG_ENABLED=false

# Application
SPRING_PROFILES_ACTIVE=api,dev
APP_MODE=dev
STORE_AUTH_REQUIRED=false
SUPPORT_AUTH_REQUIRED=false
POS_REQUIRE_MANAGER_APPROVAL=false
SUPPLIER_CREDENTIAL_KEY=
SUPPLIER_TIMESTAMP_SKEW_SECONDS=300
THEME=mall
PAYMENT_PROVIDER=mock
LOGISTICS_PROVIDER=mock
SMS_PROVIDER=mock
MAIL_PROVIDER=mailpit
DEMO_READ_ONLY=false
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Feature toggles (implemented progressively)
FEATURE_SUPPLIER_ENABLED=true
FEATURE_POS_SALE_ENABLED=true
FEATURE_POS_PICKUP_ENABLED=true
SITE_STATUS=OPEN

# Payment credentials — fill in Gitea/deployment secret manager for production.
# Demo mode uses PAYMENT_PROVIDER=mock. Production missing credentials must fail.
PAYMENT_WECHAT_MCH_ID=
PAYMENT_WECHAT_APP_ID=
PAYMENT_WECHAT_API_V3_KEY=
PAYMENT_WECHAT_PRIVATE_KEY_PATH=
PAYMENT_WECHAT_CERT_SERIAL=
PAYMENT_WECHAT_PLATFORM_PUBLIC_KEY_PATH=
PAYMENT_ALIPAY_APP_ID=
PAYMENT_ALIPAY_PRIVATE_KEY_PATH=
PAYMENT_ALIPAY_PUBLIC_KEY_PATH=
PAYMENT_UNIONPAY_MER_ID=
PAYMENT_UNIONPAY_CERT_PATH=
PAYMENT_AGGREGATOR_MERCHANT_ID=
PAYMENT_AGGREGATOR_KEY=

# Supplier API security
SUPPLIER_IP_ALLOWLIST_ENABLED=false
SUPPLIER_TOKEN_TTL_SECONDS=300
SUPPLIER_WEBHOOK_RETRY_MAX=8
SUPPLIER_WEBHOOK_BACKOFF_MS=1000

# Object storage / asset library
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=fullmall
S3_SECRET_KEY=change-me-local
S3_BUCKET=fullmall
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=

# Demo accounts are seeded by db/demo/staff.sql:
# admin / Admin@123456, operator / Operator@123456, store / Store@123456
# Change all passwords before any production deployment.

# Git downstream credentials (Gitea-only; never push to GitHub/Gitee)
# 本机推送优先使用凭据库：git config credential.helper store

# Git 凭据不在此文件：公开分叉请使用自己的凭据库（git config credential.helper store）。
# Never commit real credentials. Production uses a secret manager.
