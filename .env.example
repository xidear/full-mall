# Compose
COMPOSE_PROJECT_NAME=fullmall

# Database
POSTGRES_DB=fullmall
POSTGRES_USER=fullmall
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=fullmall
RABBITMQ_DEFAULT_PASS=change-me-local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# OpenSearch
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# SeaweedFS
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Apps
API_PORT=8080
WS_PORT=8081
WORKER_ACTUATOR_PORT=8082
STOREFRONT_PORT=3000
ADMIN_PORT=5173
STORE_CONSOLE_PORT=5174
SUPPLIER_PORTAL_PORT=5175
SUPPORT_CONSOLE_PORT=5176

# Debug ports
API_DEBUG_PORT=5005
WORKER_DEBUG_PORT=5006
WS_DEBUG_PORT=5007

# Tools
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local
WIREMOCK_PORT=8089

# Observability
GRAFANA_PORT=3001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# AI (optional)
OLLAMA_PORT=11434

# Application
SPRING_PROFILES_ACTIVE=api,dev
APP_MODE=dev
THEME=mall
PAYMENT_PROVIDER=mock
LOGISTICS_PROVIDER=mock
SMS_PROVIDER=mock
MAIL_PROVIDER=mailpit
DEMO_READ_ONLY=false
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Never commit real credentials. Production uses a secret manager.