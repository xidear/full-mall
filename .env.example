# ============================================================================
# full-mall 环境变量模板（公开分叉 / 全新环境用）
# 用法：cp .env.example .env → 按注释填自己的凭据 → docker compose up -d。
# 键与 Gitea 内部 .env 一一对应；本文件只放无害占位值，禁止写入真实密钥/证书/token
# （GitHub/Gitee 公开分叉包含本文件，内部 .env 不包含 —— AGENTS.md §6）。
# 端口已按 AGENTS.md §8 落在 41280–41286；内部 .env 仍是 8080/5173 历史值，新环境以本模板为准。
# ============================================================================

# Compose 项目名：决定容器/网络/卷名前缀。改它等于另起一套栈，旧卷不复用。
COMPOSE_PROJECT_NAME=fullmall

# --- PostgreSQL（主业务库）-------------------------------------------------
# 下面三项只在数据卷为空时初始化；已有数据时改名会连不上库，改密码需重建卷或手工改角色。
POSTGRES_DB=fullmall
POSTGRES_USER=fullmall
POSTGRES_PASSWORD=change-me-local
# 宿主机映射端口（容器内固定 5432），供本机 psql/DBeaver 直连。
POSTGRES_PORT=5432

# --- Valkey（Redis 协议缓存：会话/验证码/限流计数）--------------------------
# 仅宿主机映射端口；后端走容器网络 valkey:6379。
VALKEY_PORT=6379

# --- RabbitMQ（异步任务、Webhook 重试、事件）-------------------------------
# 账号在容器首次启动时创建；改密码要同时重启 rabbitmq 与 api，否则 api 认证失败起不来。
RABBITMQ_DEFAULT_USER=fullmall
RABBITMQ_DEFAULT_PASS=change-me-local
# AMQP 端口与 Web 管理台端口（容器内 5672 / 15672，管理台看队列积压与死信）。
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- OpenSearch（商品搜索、日志检索）--------------------------------------
# REST 与 Dashboards 的宿主机端口（容器内 9200 / 5601）。
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# --- SeaweedFS（S3 兼容对象存储：图片/素材/导出）---------------------------
# S3 API / Master / Filer 的宿主机端口（容器内 8333 / 9333 / 8888）。
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888

# --- Mailpit（本地邮件捕获，不真外发）-------------------------------------
# SMTP 与 Web 面板端口（容器内 1025 / 8025），验证码邮件在面板里看。
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# --- 应用端口（宿主侧；容器内端口在 compose.yaml 里固定）--------------------
# 按 AGENTS.md §8 使用 41280–41289 段；store-console / supplier / support 仍是
# compose 历史默认值，改端口请一并更新 docs/DEVELOPMENT_PORTS.md 与 APP_BASE_URL。
API_PORT=41280
WS_PORT=8081
WORKER_ACTUATOR_PORT=8082
STOREFRONT_PORT=41285
ADMIN_PORT=41281
STORE_CONSOLE_PORT=5174
SUPPLIER_PORTAL_PORT=5175
SUPPORT_CONSOLE_PORT=5176

# --- 调试端口（JDWP，仅开发期；生产暴露等于开放代码执行入口）----------------
API_DEBUG_PORT=5005
WORKER_DEBUG_PORT=5006
WS_DEBUG_PORT=5007

# --- 辅助工具 -------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-local
# WireMock 用于 mock 支付/短信/物流/AI 官方接口；41288 属于 §8 端口段。
WIREMOCK_PORT=41288

# --- 可观测性（otel-lgtm 一体镜像：Grafana + OTLP 收集）--------------------
GRAFANA_PORT=3001
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# --- AI（demo 走 mock；生产必须配真实供应商）-------------------------------
# mock = 确定性假结果，不调用外部模型；下面的空值即“未配置”，生产留空会被启动自检拦下。
OLLAMA_PORT=41289
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 向量化模型名（RAG 用）。
AI_EMBEDDING_MODEL=
# 关闭时只直接生成，不查知识库。
AI_RAG_ENABLED=false

# --- 应用运行模式与开关 ----------------------------------------------------
# profile：api = 只跑 HTTP API；dev/demo/prod 决定调试与安全自检强度。
SPRING_PROFILES_ACTIVE=api,dev
# dev / demo / prod：影响只读保护、演示数据、生产安全检查。
APP_MODE=dev
# 门店/客服控制台是否强制登录：开发期 false 免登录，对外部署必须 true。
STORE_AUTH_REQUIRED=false
SUPPORT_AUTH_REQUIRED=false
# POS 改价/退款/作废是否需店长审批。
POS_REQUIRE_MANAGER_APPROVAL=false
# 供应商凭据加密密钥：留空时用“仅供开发”的派生密钥并打 WARN（SupplierSecretCipher）。
SUPPLIER_CREDENTIAL_KEY=
# 供应商请求时间戳容差（秒），防重放；不要为了通过而无限放大。
SUPPLIER_TIMESTAMP_SKEW_SECONDS=300
# 前端主题标识，由 compose 传给 storefront（NUXT_PUBLIC_THEME）。
THEME=mall
# 外部渠道实现：mock = 假支付/假面单/假短信，不产生真实副作用。
PAYMENT_PROVIDER=mock
LOGISTICS_PROVIDER=mock
SMS_PROVIDER=mock
# 邮件投到本地 Mailpit 面板。
MAIL_PROVIDER=mailpit
# true 时拦截所有写操作，用于对外演示站。
DEMO_READ_ONLY=false
# 站点/接口对外基址（分享链接、回调地址用）；由 setup.sh 按 PUBLIC_URL 写入。
# localhost 只是本机调试地址，不属于对外服务（AGENTS.md §8）。
APP_BASE_URL=http://localhost:41285
API_PUBLIC_URL=http://localhost:41280

# --- 功能开关 -------------------------------------------------------------
# 注意：这四个键当前不被后端读取，运行时以数据库为准（feature_flag 表 + system_setting.site_status，
# 后台「功能开关 / 站点状态」页维护）。改这里的值不会生效，留着只为让新环境看到有哪些开关。
FEATURE_SUPPLIER_ENABLED=true
FEATURE_POS_SALE_ENABLED=true
FEATURE_POS_PICKUP_ENABLED=true
# OPEN / CLOSED / MAINTENANCE；非 OPEN 时 FeatureGuardFilter 拦前台请求。
SITE_STATUS=OPEN

# --- 支付凭据（生产必填；密钥类放部署秘管，路径类指向服务器上的证书文件）------
# PAYMENT_PROVIDER=mock 时可为空；切到真实渠道后缺凭据必须启动失败，不允许静默降级。
PAYMENT_WECHAT_MCH_ID=
PAYMENT_WECHAT_APP_ID=
PAYMENT_WECHAT_API_V3_KEY=
PAYMENT_WECHAT_PRIVATE_KEY_PATH=
PAYMENT_WECHAT_CERT_SERIAL=
PAYMENT_WECHAT_PLATFORM_PUBLIC_KEY_PATH=
PAYMENT_ALIPAY_APP_ID=
PAYMENT_ALIPAY_PRIVATE_KEY_PATH=
PAYMENT_ALIPAY_PUBLIC_KEY_PATH=
PAYMENT_UNIONPAY_MER_ID=
PAYMENT_UNIONPAY_CERT_PATH=
PAYMENT_AGGREGATOR_MERCHANT_ID=
PAYMENT_AGGREGATOR_KEY=

# --- 供应商 API 安全（对外开放的机器对机器接口）----------------------------
# 是否启用来源 IP 白名单；白名单数据在后台供应商配置里维护。
SUPPLIER_IP_ALLOWLIST_ENABLED=false
# token 有效期（秒）；缩短可降低泄露风险。
SUPPLIER_TOKEN_TTL_SECONDS=300
# Webhook 最大重试次数与指数退避基数（毫秒），避免打爆对方。
SUPPLIER_WEBHOOK_RETRY_MAX=8
SUPPLIER_WEBHOOK_BACKOFF_MS=1000

# --- 对象存储与素材库 ------------------------------------------------------
# local / qiniu / aliyun 三选一，只填选中的那组；未选中的留空。
STORAGE_PROVIDER=local
# local 用 SeaweedFS 的 S3 端点（容器内走 seaweedfs:8333，本机直连才用 localhost）。
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=fullmall
S3_SECRET_KEY=change-me-local
S3_BUCKET=fullmall
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=

# 上传解析层上限（Spring multipart）。为什么必须写死在这里而不是靠默认值：
# Spring Boot 默认单文件 1MB，比业务上限（图片 5MB / 视频 10MB）小得多，
# 超过时请求在进 Controller 之前就被拒，看起来像"上传功能坏了"。
# 必须与后端 ValidationRules.UPLOAD_MULTIPART_CEILING_BYTES 相等，不一致会启动失败。
# 图片/视频的业务上限不在这里，而是在后台「系统设置 → 素材上传」里配（保存即生效）。
UPLOAD_MULTIPART_MAX_FILE_SIZE=64MB
# 单请求总上限 = 文件上限 + multipart 头部余量。
UPLOAD_MULTIPART_MAX_REQUEST_SIZE=72MB

# --- 演示账号（db/demo/staff.sql 播种，仅 demo/dev profile）-----------------
# admin / Admin@123456、operator / Operator@123456、store / Store@123456。
# 任何对外可访问的环境必须先改这三个密码。
#
# Git 凭据不写在本文件：推送走本机凭据库（git config credential.helper store，
# 详见 docs/GIT_AND_ENVIRONMENTS.md）；本文件只允许推到 Gitea，不进 GitHub/Gitee。

# 构建形态：internal（默认，功能齐全）/ community（开源版，不含模型权重）
APP_EDITION=internal

# 主题工作室 PC 预览用：真实商城地址（iframe）
VITE_STOREFRONT_BASE=http://localhost:41285

# 主题工作室小程序预览用：uni-app H5 地址（iframe）
VITE_MOBILE_BASE=http://localhost:41286

# 通知通道：aliyun=真实短信；mock=只落库不真发
APP_SMS_PROVIDER=mock

# 示例 AI 供应商自动写入：默认 false；仅本地开发设 true
APP_AI_BOOTSTRAP=false

# AI 客服检索方式：KEYWORD=无需向量服务（默认）；SEMANTIC=需要 openai-embedding 供应商
APP_AI_ASK_RETRIEVAL=KEYWORD

# 支付通道：mock=不真扣款；真实环境必须改成 wechat/alipay
APP_PAYMENT_PROVIDER=mock
