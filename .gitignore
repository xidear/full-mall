# Java
target/
*.class
*.jar
*.war
hs_err_pid*
replay_pid*

# Maven
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node
node_modules/
.pnpm-store/
.nuxt/
.output/
dist/
coverage/
*.tsbuildinfo
.vite/

# Env & secrets
# main/public must never contain secrets. Gitea turnkey env is a tracked .env on the
# private gitea-dev branch (force-added there); never push that branch to GitHub/Gitee.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# IDE
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
*.iml

# OS
.DS_Store
Thumbs.db

# Logs & runtime
logs/
*.log
tmp/
.tmp/

# Docker
docker-data/
# 部署清单可能含内网 IP
deploy/hosts.conf

# Local only
.zcode/

# Test artifacts
web/test-results/
web/playwright-report/
# 许可证私钥绝不入库
*.pem
license-private*
.dsh-license/

# --- secrets (added 2026-10-23) ---
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
privkey*.pem
*-key.pem
*_key.pem
id_rsa*
id_ed25519*
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
*credentials*

# --- 运行时产物（2026-10-29 补）---
# 本地上传的对象存储目录：里面全是运行时素材，进库只会让 clone 变慢且泄露顾客上传内容。
# 之前有 105 个相同占位图被误提交（同一 blob），已 git rm --cached 从索引移除。
server/data/
data/

# 以 root 跑构建时留下的 target.<时间戳>/（普通用户读不了，也不该入库）
target.*/
*.original

# Python 缓存（scripts/*.py 的伴生物）
__pycache__/
*.pyc

# --- 文档里的截图/录屏等大件二进制（2026-10-29）---
# 评审截图单张 100–230KB、整套 3MB+，进库只让 clone/拉取变慢，历史还删不掉。
# 约定：截图、录屏、导出的 PDF/压缩包放文档系统或网盘，仓库只留 .md 文本与必要的
# 代码资产（server/src/main/resources/static、web/**/public 下的演示图不在此列）。
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.webp
docs/**/*.gif
docs/**/*.mp4
docs/**/*.webm
docs/**/*.pdf
docs/**/*.zip
