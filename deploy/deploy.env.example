# ============================================================================
# full-mall 部署配置（init.sh / setup.sh / start.sh / stop.sh 共用）
# 复制为仓库根目录 .env.deploy 后修改；不要提交真实密码
# ============================================================================

# 代码目录：必须是绝对路径，且包含 compose.yaml
CODE_DIR=/data/full-mall
# 数据目录：数据库卷、日志、部署状态都放这里
DATA_DIR=/opt/fullmall
# 运行用户（docker 组用户）
RUN_USER=fullmall
# 域名（host[:port]）；DB 的 site_domain 会写入这个值
SITE_DOMAIN=company.binnarui.com:15443
PUBLIC_HTTPS_PORT=15443
# 边缘证书主机名（只写 host，不带端口）
SSL_DOMAIN=company.binnarui.com
SSL_EMAIL=ops@binnarui.com
SSL_CA=letsencrypt
# http=webroot(需公网80)；dns=DNSPod DNS-01（适合 80/443 不可映射）
SSL_CHALLENGE=dns
DP_ID=
DP_KEY=

# 部署模式：single（单机）| distributed（多机，读 deploy/hosts.conf）
DEPLOY_MODE=single
# 产物模式：mounted（代码/静态文件挂载，推荐）| image（拉取镜像）| dev
DEPLOY_ARTIFACT_MODE=mounted
# 镜像仓库（可选）。需要 docker login 时填写账号；密码建议用环境变量注入
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=
API_IMAGE=
ADMIN_IMAGE=
STOREFRONT_IMAGE=

# 区域：auto（按公网 IP 判断）| cn | global；cn 会配置 Docker 镜像加速
REGION=auto
DOCKER_MIRROR=https://docker.m.daocloud.io
ALLOW_GET_DOCKER=0
INIT_PULL_IMAGES=1
FIX_CODE_OWNER=1

# 数据库：local（本机容器）| external（外部主库）| primary-replica（本机主从）
DB_MODE=local
DB_PRIMARY_HOST=postgres
DB_PRIMARY_PORT=5432
DB_REPLICA_HOSTS=
POSTGRES_DB=fullmall
POSTGRES_USER=fullmall
POSTGRES_PASSWORD=change-me-local
# 主从复制专用账号（primary-replica 模式）
POSTGRES_REPLICATION_USER=repl
POSTGRES_REPLICATION_PASSWORD=change-me-repl

# 对外 URL（setup.sh 写入 .env）
PUBLIC_SCHEME=https
API_PORT=41280
ADMIN_PORT=41281
STOREFRONT_PORT=41285
OPS_AGENT_PORT=41287
OPS_TOKEN=change-me-ops-token
WITH_TOOLS=0
WITH_OPS=1
WITH_EDGE=1

# 远程部署：deploy/hosts.conf 每行 name|ssh_target|roles|dir
# 例：edge|root@192.168.1.15|edge,ops|/data/full-mall
