*.war
hs_err_pid*
replay_pid*

# Maven
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node
node_modules/
.pnpm-store/
.nuxt/
.output/
dist/
coverage/
*.tsbuildinfo
.vite/

# Env & secrets
# main/public must never contain secrets. Gitea turnkey env is a tracked .env on the
# private gitea-dev branch (force-added there); never push that branch to GitHub/Gitee.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# IDE
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
*.iml

# OS
.DS_Store
Thumbs.db

# Logs & runtime
logs/
*.log
tmp/
.tmp/

# Docker
docker-data/
# 部署清单可能含内网 IP
deploy/hosts.conf

# Local only
.zcode/

# Test artifacts
web/test-results/
web/playwright-report/
# 许可证私钥绝不入库
*.pem
license-private*
.dsh-license/

