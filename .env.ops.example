# 边缘/运维环境变量：复制为 .env.ops 后填写
# 域名只写主机名（不要带端口/协议）；site_domain 才带 :443
SSL_DOMAIN=company.binnarui.com
SSL_EMAIL=ops@binnarui.com
SSL_CA=letsencrypt
# http = webroot 需要外网 80；dns = DNS-01（DNSPod），适合 80/443 不可映射
SSL_CHALLENGE=http
# 当 SSL_CHALLENGE=dns 时填写 DNSPod API Token（不要提交真实值）
DP_ID=
DP_KEY=
SSL_AUTO_ISSUE=true
SSL_DAYS_BEFORE=30

# 外网 HTTPS 端口（非 443 时，HTTP 跳转也会带上该端口）
PUBLIC_HTTPS_PORT=15443
# 边缘代理到本机正在运行的服务
EDGE_UPSTREAM=http://127.0.0.1:41285
EDGE_API_UPSTREAM=http://127.0.0.1:41280

# ops-agent 监听端口（项目约定 41280-41289）
OPS_AGENT_PORT=41287
# 强烈建议设置；admin 后端用同一个 token 调用 agent
OPS_TOKEN=change-me-ops-token
OPS_MANAGE_PREFIX=fullmall-
